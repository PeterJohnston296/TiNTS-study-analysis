# TiNTS bacterial genomics configuration
# Validated multi-environment/container architecture, 2026-08-19.
# Edit only if intentionally changing a prespecified analysis parameter
# or a validated software/database location.

# Override at runtime with: export TINTS_PROJECT=/path/to/project
PROJECT="${TINTS_PROJECT:-${HOME}/TiNTS_genomics}"
# Override if Conda is installed elsewhere.
CONDA="${TINTS_CONDA:-${HOME}/miniforge3/bin/conda}"

# ----------------------------------------------------------------------
# Authoritative metadata
# ----------------------------------------------------------------------

LIBRARY_METADATA="${PROJECT}/00_metadata/library_metadata.tsv"
ISOLATE_METADATA="${PROJECT}/00_metadata/isolate_metadata.tsv"
FULL_METADATA="${PROJECT}/00_metadata/full_genomics_metadata.tsv"

LIBRARY_METADATA_SHA256="78e57ebdb31055ade431d541cb7ce77cae9b3c2ce0d78650efb7f0bee502536e"
ISOLATE_METADATA_SHA256="43448d3aa87ef10f20e233b8dc29fe12cd4d6c7528ea0c8ee515d5c4056835bd"
FULL_METADATA_SHA256="54e7f8086a66101f85f1b29bbc3265b70aa8e6e9947c570bdf9fa1ead562851c"

EXPECTED_LIBRARIES=111
EXPECTED_BIOLOGICAL_ISOLATES=85
EXPECTED_MLW_LIBRARIES=71
EXPECTED_CGR_LIBRARIES=40
EXPECTED_HUMAN_ISOLATES=43
EXPECTED_ENVIRONMENTAL_ISOLATES=42

# ----------------------------------------------------------------------
# Input locations
# ----------------------------------------------------------------------

MLW_RAW_DIR="${PROJECT}/01_raw/MLW_standard"
MLW_ANALYSIS_FASTQ_DIR="${PROJECT}/02_analysis_fastq/MLW"
CGR_RAW_CRAM_DIR="${PROJECT}/01_raw/CGR_deep_cram"
CGR_ANALYSIS_FASTQ_DIR="${PROJECT}/02_analysis_fastq/CGR_deep"

# ----------------------------------------------------------------------
# Native/Homebrew tools
# ----------------------------------------------------------------------

FASTP_BIN="/opt/homebrew/bin/fastp"
BOWTIE2_BIN="/opt/homebrew/bin/bowtie2"
KRAKEN2_BIN="/opt/homebrew/bin/kraken2"
SPADES_BIN="/opt/homebrew/bin/spades.py"
SEQKIT_BIN="/opt/homebrew/bin/seqkit"
SAMTOOLS_BIN="/opt/homebrew/bin/samtools"
RASUSA_BIN="/opt/homebrew/bin/rasusa"
MAFFT_BIN="/opt/homebrew/bin/mafft"

# ----------------------------------------------------------------------
# Dedicated Conda environments
# ----------------------------------------------------------------------

CHECKM_ENV="tints-checkm"
QUAST_ENV="tints-quast"
SISTR_ENV="tints-sistr"
AMRFINDER_ENV="tints-amrfinder"
SNP_TOOLS_ENV="tints-snp-tools"
GUBBINS_ENV="tints-gubbins"

CHECKM_ENV_EXPORT="${PROJECT}/00_metadata/tints-checkm_environment.yml"
QUAST_ENV_EXPORT="${PROJECT}/00_metadata/tints-quast_environment.yml"
SISTR_ENV_EXPORT="${PROJECT}/00_metadata/tints-sistr_environment.yml"
AMRFINDER_ENV_EXPORT="${PROJECT}/00_metadata/tints-amrfinder_environment.yml"
SNP_TOOLS_ENV_EXPORT="${PROJECT}/00_metadata/tints-snp-tools_environment.yml"
GUBBINS_ENV_EXPORT="${PROJECT}/00_metadata/tints-gubbins_environment.yml"

# ----------------------------------------------------------------------
# Native/source MLST toolchain
# ----------------------------------------------------------------------

MLST_BIN="${PROJECT}/tools/mlst/bin/mlst"
ANY2FASTA_BIN="${PROJECT}/tools/any2FASTA/any2fasta"
NCBI_BLAST_BIN_DIR="${PROJECT}/tools/ncbi-blast/ncbi-blast-2.17.0+/bin"

MLST_ENV_FILE="${PROJECT}/00_metadata/tints_mlst.env"
BLAST_ENV_FILE="${PROJECT}/00_metadata/tints_blast.env"

# ----------------------------------------------------------------------
# Containers
# ----------------------------------------------------------------------

PROKKA_IMAGE="docker.io/staphb/prokka:1.15.6"
PROKKA_PLATFORM="linux/amd64"
PROKKA_IMAGE_DIGEST="sha256:60af8933ee49b400c35962cf0a2361bd0232f562827afb16e6574761e3b5a5ba"

PANAROO_IMAGE="quay.io/biocontainers/panaroo:1.8.0--pyhdfd78af_0"
PANAROO_PLATFORM="linux/amd64"
PANAROO_IMAGE_DIGEST="sha256:1a062989addadbdae85a804306760ad9513a206aa376fb31795e99a57780992a"

# ----------------------------------------------------------------------
# IQ-TREE
# ----------------------------------------------------------------------

IQTREE3_BIN="${PROJECT}/tools/iqtree3/iqtree-3.1.3-macOS-arm/bin/iqtree3"
IQTREE3_SHA256="ef315410ae846f0f96593f85adde9745a075dd655dc93ef858f2aff8ec8695e2"

# IQ-TREE 3 is used for the broad Salmonella tree only.
# Fine-scale Gubbins analyses use the isolated IQ-TREE 2.4.0 inside tints-gubbins.

# ----------------------------------------------------------------------
# Databases
# ----------------------------------------------------------------------

KRAKEN_DB="${PROJECT}/databases/kraken2_standard16_20260226"
KRAKEN_DB_SNAPSHOT="2026-02-26"
KRAKEN_DB_MANIFEST_SHA256="953f4b9d7e6a203493014d6a0081b2aa49d5d70305713a5c6bb3ee818679c2ac"

CHECKM_DB="${PROJECT}/databases/checkm/checkm_data_2015_01_16"
CHECKM_DB_SNAPSHOT="2015-01-16"
CHECKM_DB_MANIFEST_SHA256="fbbd968d29d72a2c6dcdf99cb11af7582db13623e2a656cc5650d560b57afc8f"

AMRFINDER_DB="${HOME}/miniforge3/envs/tints-amrfinder/share/amrfinderplus/data/2026-08-07.1"
AMRFINDER_DB_VERSION="2026-08-07.1"
AMRFINDER_DB_MANIFEST_SHA256="c04b0472cc331d09afebc48276575da79372d94f150f04940f3e83d59e79d09f"

# ----------------------------------------------------------------------
# Human host-depletion reference
# ----------------------------------------------------------------------

HUMAN_REFERENCE_ACCESSION="GCF_009914755.1"
HUMAN_REFERENCE_NAME="T2T-CHM13v2.0"
HUMAN_REFERENCE_FASTA="${PROJECT}/databases/human/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna"
HUMAN_BOWTIE2_INDEX="${PROJECT}/databases/human/T2T-CHM13v2.0"
HUMAN_REFERENCE_MANIFEST_SHA256="728fff9d99586918d1015cceec912fa828a43b9ee6aeddfb20372f5e157cb9c9"

# ----------------------------------------------------------------------
# Prespecified taxonomy rules
# ----------------------------------------------------------------------

SALMONELLA_TAXID=590
HUMAN_TAXID=9606
SALMONELLA_READ_PCT_THRESHOLD=70.0

# ----------------------------------------------------------------------
# Human-read removal
# ----------------------------------------------------------------------

HOST_FILTER_PRESET="--very-sensitive-local"
HOST_FILTER_THREADS=12
SAMTOOLS_THREADS=4

# Pair-retention rule:
# retain a read pair only when BOTH mates are unmapped to the human reference.

# ----------------------------------------------------------------------
# Prespecified depth harmonisation
# ----------------------------------------------------------------------

DEPTH_CAP_X=120
PLANNING_GENOME_SIZE_BP=5000000
DOWNSAMPLE_SEED=42

# Coverage is calculated after host depletion.
# Libraries <=120x are unchanged.
# Libraries >120x are deterministically capped to 120x.

# ----------------------------------------------------------------------
# Computational resources
# ----------------------------------------------------------------------

FASTP_THREADS=8
KRAKEN_THREADS=12
SPADES_THREADS=8
SPADES_MEMORY_GB=18
ASSEMBLY_JOBS=2
CHECKM_THREADS=8
PANAROO_THREADS=12
IQTREE_THREADS=12

# ----------------------------------------------------------------------
# Exact Rigby et al. assembly-QC thresholds
# ----------------------------------------------------------------------

MAX_CONTAMINATION=20.0
MIN_COMPLETENESS=90.0
MAX_CONTIGS=500
MIN_N50=20000
MIN_GENOME_LENGTH=4000000
MAX_GENOME_LENGTH=5800000

# ----------------------------------------------------------------------
# Broad Salmonella phylogeny
# ----------------------------------------------------------------------

PANAROO_IDENTITY=0.95
PANAROO_CORE_THRESHOLD=1.00
TREE_SEED=42

# Gubbins must NOT be applied species-wide to the diverse broad Salmonella tree.

# ----------------------------------------------------------------------
# Technical-replicate SNP comparison
# ----------------------------------------------------------------------

SNIPPY_IMAGE="docker.io/staphb/snippy:4.6.0"
SNIPPY_PLATFORM="linux/amd64"
SNIPPY_IMAGE_DIGEST="sha256:6a9db00665caa081d9ba4da13aca8ab9568814ebb98f1a0d66bff93e740b0ab4"

# Snippy is used ONLY for known MLW/CGRdeep technical-resequencing
# comparisons. It is not a transmission-threshold tool.
TECHNICAL_REPLICATE_MAX_SNP=2

# ----------------------------------------------------------------------
# Tree plotting
# ----------------------------------------------------------------------

PLOT_ENV="tints-plot"
PLOT_ENV_EXPORT="${PROJECT}/00_metadata/tints-plot_environment.yml"
PLOT_ENV_EXPORT_SHA256="8dcc6e081151215eb07e6c28b5ae46e2dac82980c7ad04f4cb2590632c325d98"
